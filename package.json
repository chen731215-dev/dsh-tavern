{
    "version":  "1.2.0",
    "peerDependencies":  {
                             "@deepseek-ai/dsh-client-runtime":  "^0.1.0-rc.6"
                         },
    "name":  "dsh-tavern",
    "type":  "module",
    "exports":  {
                    "./client":  "./lib/client.manager.bundle.js",
                    "./package.json":  "./package.json",
                    ".":  "./lib/index.js"
                },
    "description":  "DeepSeek 酒馆 - 会话级多预设隔离：每个会话独立绑定角色卡/世界书/预设，自动注入对话；原生管理面板，深色主题，记忆总结。",
    "dsh":  {
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime"
                                          ],
                               "platform":  "web"
                           },
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "main":  "lib/index.js"
}
